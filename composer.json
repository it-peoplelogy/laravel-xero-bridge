{
    "name": "peoplelogy/laravel-xero-bridge",
    "description": "Laravel wrapper for the Xero Accounting API, plus an optional, disabled-by-default LHDN MyInvois taxpayer TIN validator for Malaysia.",
    "keywords": [
        "Peoplelogy",
        "laravel",
        "laravel-xero-bridge",
        "xero",
        "myinvois",
        "lhdn",
        "e-invoice",
        "malaysia"
    ],
    "homepage": "https://github.com/it-peoplelogy/laravel-xero-bridge",
    "license": "proprietary",
    "authors": [
        {
            "name": "Sumesh Vasu",
            "email": "pips@peoplelogy.com.my",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.93",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^3.8||^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^3.2||^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Peoplelogy\\XeroBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peoplelogy\\XeroBridge\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@composer run prepare"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": "@php -d memory_limit=512M vendor/bin/pest",
        "test-coverage": "@php -d memory_limit=512M vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Peoplelogy\\XeroBridge\\XeroBridgeServiceProvider"
            ],
            "aliases": {
                "XeroBridge": "Peoplelogy\\XeroBridge\\Facades\\XeroBridge"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
