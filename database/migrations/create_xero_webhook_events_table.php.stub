<?php

declare(strict_types=1);

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Database\Schema\Builder;
use Illuminate\Support\Facades\Schema;

/**
 * Durable dedupe for Xero's 31-day webhook replay window.
 *
 * The uniqueness lock on ProcessXeroWebhook catches a retry storm within
 * minutes. It cannot catch a replay Xero sends DAYS later: undelivered events
 * are stored for up to 31 days and replayed in order once your endpoint
 * recovers. This table is what makes that late replay a no-op.
 */
return new class extends Migration
{
    public function up(): void
    {
        /*
         * Guarded, because a package migration is PUBLISHED and its filename
         * carries the timestamp of the moment it was published -- not a fixed
         * one the way an application's own migration does.
         *
         * So two environments that publish at different moments end up with two
         * different filenames for the same table. Commit one of them, deploy to
         * a server that already published its own, and Laravel sees a migration
         * it has never run, tries to create a table that is already there, and
         * stops the whole deployment on 1050 "table already exists".
         *
         * Existing means done. The table is created once and never altered
         * here, so there is nothing for a second run to catch up on, and a
         * consumer who hits the duplicate can simply run migrate again.
         */
        if ($this->schema()->hasTable($this->table())) {
            return;
        }

        $this->schema()->create($this->table(), function (Blueprint $table) {
            $table->id();

            /*
             * sha256 of tenantId|resourceId|eventType|eventDateUtc -- see
             * WebhookEvent::dedupeKey(), which is the single place that key is
             * defined.
             *
             * UNIQUE is the entire point of this table. The insert IS the
             * claim: two workers racing on the same replayed event means one
             * insert succeeds and the other hits a constraint violation, which
             * is a far better outcome than both dispatching the event.
             *
             * Deliberately NOT keyed on the envelope's `entropy`, which Xero
             * varies between deliveries of the same logical event.
             */
            $table->string('dedupe_key', 64)->unique();

            // Kept in readable form for operators. "Did that invoice update
            // ever arrive?" is the question this table gets asked, and nobody
            // can answer it from a hash.
            $table->string('tenant_id', 64)->index();
            $table->string('resource_id', 64)->index();
            $table->string('event_type', 32);
            $table->string('event_category', 32);

            // Xero's own timestamp for the change, as sent: like
            // 2026-09-29T01:15:39.902, with no trailing Z. Stored as a string
            // because it is an identity component, and reformatting an
            // identity component is how dedupe keys drift.
            $table->string('event_date_utc', 32);

            /*
             * When we FIRST dispatched it, and how many further deliveries
             * arrived afterwards.
             *
             * delivery_count > 1 is the interesting number: it is direct
             * evidence of a replay, and the only way to know whether the 31-day
             * window is actually being exercised in production.
             */
            /*
             * useCurrent() is not cosmetic and must not be "tidied" away.
             *
             * MySQL gives the FIRST timestamp column in a table an implicit
             * DEFAULT CURRENT_TIMESTAMP **ON UPDATE CURRENT_TIMESTAMP**, and
             * gives every later one an implicit default of the zero date --
             * which strict mode then rejects outright with
             * "Invalid default value", so the table cannot even be created.
             *
             * Naming a default explicitly fixes both: the column keeps NOT
             * NULL, the migration runs, and no column silently rewrites itself
             * when the row is updated. That second half is the one that would
             * have hurt: these columns are written once and read as evidence,
             * and an implicit ON UPDATE would quietly turn "first" into "last".
             *
             * sqlite does not do any of this, so the test suite cannot catch
             * it. See tests/Unit/MigrationTimestampTest.php, which reads these
             * files as text for exactly that reason.
             */
            $table->timestamp('first_seen_at')->useCurrent()->index();
            $table->timestamp('last_seen_at')->useCurrent();
            $table->unsignedInteger('delivery_count')->default(1);
        });
    }

    public function down(): void
    {
        $this->schema()->dropIfExists($this->table());
    }

    /**
     * Resolve through the configured connection so the HOST's prefix applies.
     * pips sets prefix 'pips_' with prefix_indexes on its mysql connection, so
     * this creates pips_xero_webhook_events there. Indexes are deliberately
     * left unnamed for the same reason.
     */
    private function schema(): Builder
    {
        return Schema::connection(config('xero-bridge.database.connection'));
    }

    private function table(): string
    {
        return config('xero-bridge.webhooks.dedupe.table', 'xero_webhook_events');
    }
};
