<?php

declare(strict_types=1);

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Database\Schema\Builder;
use Illuminate\Support\Facades\Schema;

/**
 * Every Xero and LHDN call this application made, request and response.
 *
 * Exists so a consuming project can render the traffic on ITS OWN dashboard.
 * This package ships no viewer for it -- the schema is the interface, and the
 * models beside it are the supported way in.
 *
 * TWO WARNINGS, both of which have cost someone a weekend somewhere:
 *
 *   THIS IS NOT A LEDGER. The row is written AFTER the response, so a worker
 *   killed mid-call leaves no row at all. "Did that invoice reach Xero?" is
 *   answered by xero_write_records, which is inserted BEFORE the request
 *   precisely so it survives that. Never answer it from here.
 *
 *   BODIES ARE REDACTED ON THE WAY IN, never on the way out. Bank details and
 *   credentials are removed before the insert, because a raw row reaches the
 *   binary log, the nightly backup, the read replica and every SELECT * in a
 *   support tool. What is stored here is safe to show; that is the whole
 *   contract, and Support\RedactionPolicy is where it is enforced.
 */
return new class extends Migration
{
    /**
     * Every column create() below makes: how this migration tells its own
     * table from a stranger's that happens to have the same name.
     *
     * FROZEN -- the columns the table first shipped with, and nothing else.
     * A column added by a later release arrives in a migration of its own,
     * so a table this file created before then lacks it and must still count
     * as ours; listing it here would make a re-run refuse that table. Never
     * trim it either: the full set is what a lookalike fails on, where a few
     * generic names such as method, url and status would let one through.
     *
     * Lower-case, because the comparison is case-folded. Most telling first,
     * because the refusal quotes the first few that are missing.
     */
    private const COLUMNS = [
        // Peculiar to this package.
        'logical_call_id', 'redacted_keys', 'connection_key', 'channel', 'attempt', 'correlation_id',
        // Common to any table logging HTTP calls.
        'id', 'tenant_id', 'method', 'url', 'request_headers', 'request_body', 'status', 'response_headers',
        'response_body', 'content_type', 'response_bytes', 'duration_ms', 'error', 'idempotency_key',
        'owner_type', 'owner_id', 'created_at',
    ];

    public function up(): void
    {
        /*
         * Guarded, because a package migration is PUBLISHED and its filename
         * carries the timestamp of the moment it was published -- not a fixed
         * one the way an application's own migration does.
         *
         * So two environments that publish at different moments end up with two
         * different filenames for the same table. Commit one of them, deploy to
         * a server that already published its own, and Laravel sees a migration
         * it has never run, tries to create a table that is already there, and
         * stops the whole deployment on 1050 "table already exists".
         *
         * Existing AND ours means done. The table is created once and never
         * altered here, so there is nothing for a second run to catch up on,
         * and a consumer who hits the duplicate can simply run migrate again.
         *
         * Existing and NOT ours is refused, before any DDL. Adopting it would
         * record this migration as run over a table the package cannot use,
         * and hide the clash until something fails against it. Refused, the
         * migration stays unrecorded, and the next migrate resumes here once
         * the clash is resolved.
         */
        if ($this->schema()->hasTable($this->table())) {
            if (($missing = $this->missingColumns()) !== []) {
                $this->refuse($missing);
            }

            return;
        }

        $this->schema()->create($this->table(), function (Blueprint $table) {
            $table->id();

            /*
             * Which API, and which credential set. Four values today:
             * xero.api, xero.identity, myinvois.api, myinvois.token.
             *
             * Indexed because the first thing any dashboard does is separate
             * the business traffic from the token traffic.
             */
            $table->string('channel', 24)->index();

            /*
             * The configured Xero connection this went out on. Nullable: the
             * identity and MyInvois channels have no connection, and a call
             * made before any organisation is connected still deserves a row.
             */
            $table->string('connection_key', 64)->nullable()->index();

            /*
             * The organisation. Without it a row cannot be attributed in a
             * multi-org install -- the same customer has a different ContactID
             * in every connected organisation, so a row with no tenant is
             * ambiguous rather than merely incomplete.
             */
            $table->string('tenant_id', 64)->nullable()->index();

            /*
             * One logical call, one id -- shared by every wire attempt it took.
             *
             * A single invoices()->create() can be more than one HTTP request:
             * the client replays once after a 401 with a refreshed token. Those
             * are separate rows with attempt 1 and 2, and this is what puts
             * them back together. Without it "why did this take two round
             * trips?" is unanswerable from the table.
             */
            $table->string('logical_call_id', 36)->index();

            $table->unsignedTinyInteger('attempt')->default(1);

            $table->string('method', 8);

            /*
             * REDACTED. The MyInvois TIN is a path segment and Xero `where`
             * clauses carry customer email addresses, so this column is put
             * through the redactor exactly like a body. Text, not string: a
             * filter clause with several conditions outgrows 255 easily.
             */
            $table->text('url');

            $table->json('request_headers')->nullable();
            $table->json('request_body')->nullable();

            /*
             * Null means the call never got an answer -- a timeout or a DNS
             * failure -- which is the single most interesting row in the table
             * and the reason `error` exists beside it.
             */
            $table->unsignedSmallInteger('status')->nullable()->index();

            $table->json('response_headers')->nullable();

            /*
             * Stored only when the response was JSON. A PDF is megabytes of
             * binary whose rendered content carries the organisation's own bank
             * details from the branding theme, and nobody debugs a PDF by
             * reading it out of a database column, so those rows keep
             * content_type and response_bytes and nothing else.
             */
            $table->json('response_body')->nullable();
            $table->string('content_type', 96)->nullable();
            $table->unsignedInteger('response_bytes')->nullable();

            $table->unsignedInteger('duration_ms')->nullable();

            // Exception class and message, itself put through the redactor:
            // a client exception message can quote the URL it failed on.
            $table->string('error', 500)->nullable();

            /*
             * Which rules fired on this row. Not decoration -- it is how a
             * reader tells "we never sent a TaxNumber" from "we sent one and
             * hid it", which are different answers to a real support question.
             */
            $table->json('redacted_keys')->nullable();

            /*
             * Lifted out of the headers into their own columns, because both
             * are join keys and no dashboard should have to parse JSON to use
             * them: idempotency_key joins to xero_write_records and is the only
             * way to tell a retry from a genuine duplicate; correlation_id is
             * the id LHDN support asks for and cannot be recovered afterwards.
             */
            $table->string('idempotency_key', 128)->nullable()->index();
            $table->string('correlation_id', 64)->nullable()->index();

            /*
             * The consuming project's own record, when it declared one. This
             * is what makes a dashboard possible at all: without it a project
             * cannot join these rows to its orders or its customers.
             *
             * A plain string rather than nullableMorphs(), so a host using UUID
             * or ULID primary keys is not forced into an integer column.
             */
            $table->string('owner_type', 191)->nullable();
            $table->string('owner_id', 64)->nullable();

            /*
             * useCurrent() is not cosmetic and must not be "tidied" away.
             *
             * MySQL gives the FIRST timestamp column in a table an implicit
             * DEFAULT CURRENT_TIMESTAMP **ON UPDATE CURRENT_TIMESTAMP**, and
             * gives every later one an implicit default of the zero date --
             * which strict mode then rejects outright with
             * "Invalid default value", so the table cannot even be created.
             *
             * Naming a default explicitly fixes both: the column keeps NOT
             * NULL, the migration runs, and no column silently rewrites itself
             * when the row is updated. That second half is the one that would
             * have hurt: these columns are written once and read as evidence,
             * and an implicit ON UPDATE would quietly turn "first" into "last".
             *
             * sqlite does not do any of this, so the test suite cannot catch
             * it. See tests/Unit/MigrationTimestampTest.php, which reads these
             * files as text for exactly that reason.
             */
            $table->timestamp('created_at')->useCurrent()->index();

            $table->index(['owner_type', 'owner_id']);
            $table->index(['channel', 'status']);
        });
    }

    public function down(): void
    {
        /*
         * Only a table this migration could have created. Being recorded as
         * run is no proof of that: the 1.4.3 version of this file recorded
         * itself over ANY table of this name, and republishing rewrites the
         * file in place without touching that record. Dropping a stranger's
         * table would take the host's data with it, so a table without these
         * columns is left exactly as it is.
         *
         * What this cannot tell apart is a second copy of this same
         * migration. If a republished duplicate was recorded over the table
         * the first copy created, rolling the duplicate back still drops the
         * live table: delete the later file and its row in `migrations`.
         */
        if (! $this->schema()->hasTable($this->table()) || $this->missingColumns() !== []) {
            return;
        }

        $this->schema()->dropIfExists($this->table());
    }

    /**
     * Resolve through the configured connection so the HOST's prefix applies.
     * A connection with prefix 'app_' (and prefix_indexes) therefore gets
     * app_xero_api_calls; elsewhere the bare name. Indexes are deliberately
     * left unnamed for the same reason.
     */
    private function schema(): Builder
    {
        return Schema::connection(config('xero-bridge.database.connection'));
    }

    private function table(): string
    {
        return config('xero-bridge.capture.table', 'xero_api_calls');
    }

    /**
     * The original columns the existing table lacks; none means it is ours.
     *
     * getColumnListing() applies the connection prefix itself, as hasTable()
     * does, and the names are case-folded the way Schema::hasColumns() folds
     * them. Columns a host added on top are ignored: a superset is still ours.
     *
     * @return list<string>
     */
    private function missingColumns(): array
    {
        $present = array_map('strtolower', $this->schema()->getColumnListing($this->table()));

        return array_values(array_diff(self::COLUMNS, $present));
    }

    /**
     * Stop the migration, naming the table and the way out.
     *
     * A plain RuntimeException, never one of the package's own classes: this
     * file is published into the application and outlives `composer remove`,
     * where a missing class would replace the whole message with "Class not
     * found".
     *
     * @param  list<string>  $missing
     */
    private function refuse(array $missing): never
    {
        $connection = $this->schema()->getConnection();
        $shown = array_slice($missing, 0, 3);
        $more = count($missing) - count($shown);

        throw new RuntimeException(sprintf(
            'Table "%s" on database connection "%s" already exists, but it is not the table this migration '
            .'creates (missing %s: "%s"%s). Nothing was changed. To keep that table, give the package another '
            .'one: set XERO_CAPTURE_TABLE (config key xero-bridge.capture.table) to an unused, bare table name '
            .'-- the connection adds its own prefix -- run "php artisan config:clear" if your config is cached, '
            .'and migrate again. If the table is a leftover nothing uses, drop or rename it, then migrate again.',
            $connection->getTablePrefix().$this->table(),
            $connection->getName(),
            count($missing) === 1 ? 'column' : 'columns',
            implode('", "', $shown),
            $more > 0 ? " and {$more} more" : '',
        ));
    }
};
