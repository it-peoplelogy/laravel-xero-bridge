             * row here becomes unmatchable. That is the price of the identifier
             * not being recoverable from the row.
             */
            $table->string('subject_hash', 64)->unique();

            /*
             * LHDN's closed allow-list: NRIC, PASSPORT, BRN or ARMY. A
             * CATEGORY, not an identifier -- it narrows nothing on its own and
             * is what makes the table readable to an operator.
             */
            $table->string('id_type', 16);

            /*
             * The last four characters of the TIN, for humans.
             *
             * Enough to recognise a record you are already looking at;
             * nowhere near enough to reconstruct one you are not. Without it
             * the table is unreadable to the person who has to act on it.
