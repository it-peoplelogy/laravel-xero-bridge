            $table->string('tin_last4', 8)->nullable();

            // true = HASiL holds the pair. false = it does not.
            $table->boolean('verdict');

            // 200 or 404. Kept because "not found" and "we never got an answer"
            // must never look the same in an audit.
            $table->unsignedSmallInteger('http_status')->nullable();

            // LHDN's own request id. The thing their support asks for, and it
            // cannot be recovered after the fact.
            $table->string('correlation_id', 64)->nullable();

            // sandbox or production. A sandbox verdict must never be mistaken
            // for evidence about a real taxpayer.
            $table->string('environment', 16);

            /*
             * Which RULES produced this verdict.
             *
             * On 1 August 2026 LHDN began validating the TIN and the identifier
             * as a PAIR; before that a loosely-matched pair passed. A verdict
             * recorded under the old rules answered a weaker question, so the
             * version is stored rather than assumed -- when LHDN changes the
             * rules again, on a month's notice as they have before, everything
             * below the new version can be invalidated wholesale.
